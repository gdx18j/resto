# Copy this file to .env and fill every blank value before running Docker Compose.
# Blank required values intentionally make `docker compose up` fail.

DJANGO_ENV=production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=example.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
DJANGO_HEALTHCHECK_HOST=127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_PROXY_SSL_HEADER=True
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8000

DB_NAME=resto_db
DB_USER=resto_user
DB_PASSWORD=

REDIS_URL=redis://redis:6379/1

HTTP_PORT=80
HTTPS_PORT=443

DB_CPUS=1.0
DB_MEMORY_LIMIT=512m
REDIS_CPUS=0.5
REDIS_MEMORY_LIMIT=256m
WEB_CPUS=1.0
WEB_MEMORY_LIMIT=768m
NGINX_CPUS=0.5
NGINX_MEMORY_LIMIT=256m

DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5
GELF_ADDRESS=

GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
IMPORT_SEED_DATA_ON_STARTUP=False
IMPORT_SEED_IMAGES_ON_STARTUP=False

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

SITE_URL=https://example.com
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_MOCK=False

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
AI_MAX_OUTPUT_TOKENS=600
AI_HISTORY_LIMIT=12
AI_MENU_CONTEXT_LIMIT=80
AI_HISTORY_RETENTION_DAYS=180
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_RATE_LIMIT_IP_PER_MINUTE=30
AI_RATE_LIMIT_GUEST_PER_MINUTE=6
AI_RATE_LIMIT_USER_PER_MINUTE=12
AI_DAILY_QUOTA_IP=120
AI_DAILY_QUOTA_GUEST=25
AI_DAILY_QUOTA_USER=80
AI_DAILY_TOKEN_BUDGET_IP=160000
AI_DAILY_TOKEN_BUDGET_GUEST=30000
AI_DAILY_TOKEN_BUDGET_USER=100000
AI_ESTIMATED_RESPONSE_TOKENS=600
AI_ESTIMATED_COST_MICROS_PER_1000_TOKENS=0
AI_DAILY_COST_BUDGET_MICROS_IP=0
AI_DAILY_COST_BUDGET_MICROS_GUEST=0
AI_DAILY_COST_BUDGET_MICROS_USER=0
AI_STREAM_CONCURRENCY_IP=5
AI_STREAM_CONCURRENCY_GUEST=1
AI_STREAM_CONCURRENCY_USER=2
AI_STREAM_LOCK_TIMEOUT_SECONDS=180
AI_ABUSE_BLOCK_THRESHOLD=8
AI_ABUSE_BLOCK_SECONDS=600
AI_TRUST_X_FORWARDED_FOR=False
